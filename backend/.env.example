# Copy to .env before running: cp .env.example .env
NODE_ENV=development
PORT=4000

# SQLite file location (relative paths resolve from the backend/ directory)
DATABASE_PATH=./data/confluencr.sqlite

# Change this in any non-local environment
JWT_SECRET=dev-only-change-me-7f3c1a9b2d4e6f8a
JWT_EXPIRES_IN=12h

# Comma separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Requests per window, per IP
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600

# HTTP request logging: combined | dev | off
LOG_FORMAT=dev
