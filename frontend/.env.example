# Optional. Leave unset to use the Vite dev proxy (/api -> http://localhost:4000).
# Set this when the API runs somewhere else, e.g. a deployed environment.
# VITE_API_BASE_URL=http://localhost:4000/api/v1

# Optional. Changes where the dev proxy forwards /api requests.
# VITE_API_PROXY_TARGET=http://localhost:4000
